# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/foliosync

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage (Cloudflare R2 or AWS S3)
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<access_key_id>
STORAGE_SECRET_ACCESS_KEY=<secret_access_key>
STORAGE_BUCKET=foliosync-documents

# File upload limits
MAX_FILE_SIZE_MB=50
