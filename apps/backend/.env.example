# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foliosync?appName=Cluster0

# JWT (use long random strings, at least 32 characters)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage (Cloudflare R2 or AWS S3)
# Document uploads are rejected with STORAGE_NOT_CONFIGURED until these are real values.
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<access_key_id>
STORAGE_SECRET_ACCESS_KEY=<secret_access_key>
STORAGE_BUCKET=foliosync-documents

# File upload limits
MAX_FILE_SIZE_MB=50
